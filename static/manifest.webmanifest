{
	"name": "be-diary",
	"short_name": "be-diary",
	"description": "Diary harian terenkripsi ujung ke ujung.",
	"lang": "id",
	"start_url": "/app",
	"scope": "/",
	"display": "standalone",
	"display_override": [
		"window-controls-overlay",
		"standalone"
	],
	"orientation": "portrait-primary",
	"background_color": "#14171A",
	"theme_color": "#14171A",
	"icons": [
		{
			"src": "/icons/192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/maskable.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Tulis hari ini",
			"url": "/app/hari-ini"
		},
		{
			"name": "Cari",
			"url": "/app/cari"
		}
	]
}
